<!--
  The Windows installer (WiX 5), built by the release workflow:
    wix build -arch x64 -d Version=0.11.0 -d Bin=dist\netcheck-windows-amd64.exe ^
      packaging\windows\netcheck.wxs -o dist\netcheck-windows-amd64.msi

  Per user, like `netcheck install`: no admin rights, the same folder
  (%LOCALAPPDATA%\Programs\netcheck), and that folder on the user PATH.
  A newer MSI replaces an older one; Settings > Apps removes it.
  The UpgradeCode must never change.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="netcheck"
           Manufacturer="tworjaga"
           Version="$(Version)"
           UpgradeCode="{EB41FAEE-EE23-4672-BBAA-86CABFC358E0}"
           Scope="perUser"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of netcheck is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/tworjaga/netcheck" />
    <Property Id="ARPHELPLINK" Value="https://github.com/tworjaga/netcheck/issues" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="netcheck" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="Netcheck" Directory="INSTALLFOLDER">
      <Component Id="NetcheckExe" Guid="{6F1D2C1A-3B7E-4E4F-9A55-2C0F9E1B7D31}">
        <File Id="NetcheckExeFile" Source="$(Bin)" Name="netcheck.exe" KeyPath="no" />
        <!-- A per-user component needs a registry key path. -->
        <RegistryValue Root="HKCU" Key="Software\netcheck" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        <Environment Id="UserPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="no" Permanent="no" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="netcheck">
      <ComponentGroupRef Id="Netcheck" />
    </Feature>
  </Package>
</Wix>
